# /etc/ck-host-status.env (root, mode 0600): only CK_ lines are read
CK_STATUS_DIR=/opt/magento/shared/var/app-health
CK_SOURCE=shop-1
# every container of a Compose project (its "-p" name, or the folder's) - or a list of those that must run:
CK_COMPOSE_PROJECT=shop
#CK_CONTAINERS=mariadb php cron rabbitmq opensearch cache session varnish nginx
CK_CONTAINER_MEM_WARN=85
CK_CONTAINER_CPU_WARN=90
CK_DISKS=/ /var/lib/docker
#CK_BACKUP_FILE=/var/backups/magento/last-success
#CK_SSL_HOSTS=shop.example.com
