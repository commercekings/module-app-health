{
    "name": "commercekings/module-app-health",
    "description": "Magento health alerts for the shop team: cron, indexers, caches, maintenance mode, email settings, exception spikes, queue backlogs and failing emails, checked by cron every 5 minutes and sent through commercekings/module-notification (e.g. to Slack) on a change, with a daily summary and an optional heartbeat.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "CommerceKings"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.4",
        "magento/framework-amqp": "^100.4",
        "magento/framework-message-queue": "^100.4",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-cron": "^100.4",
        "magento/module-store": "^101.1",
        "commercekings/module-core": "^0.1",
        "commercekings/module-notification": "^0.1"
    },
    "suggest": {
        "commercekings/module-notification-slack": "Send the alerts to a Slack channel (channel code \"slack\")"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CommerceKings\\AppHealth\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/Test/",
            "/.github/",
            "/.gitignore",
            "/.gitattributes"
        ]
    },
    "homepage": "https://github.com/commercekings/module-app-health",
    "support": {
        "issues": "https://github.com/commercekings/module-app-health/issues",
        "source": "https://github.com/commercekings/module-app-health"
    }
}
