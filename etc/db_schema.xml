<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <!-- the module's only table, a few dozen rows (Model\StateStore): check results, cursors, what each website's
         team was told, hourly tallies. Names, statuses and counts only. -->
    <table name="ck_app_health_state" resource="default" engine="innodb" comment="CK app health: state">
        <column xsi:type="varchar" name="state_key" nullable="false" length="64" comment="checks, cursor:..., alerted:..., tally:..."/>
        <column xsi:type="mediumtext" name="value" nullable="false" comment="JSON"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Last change"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="state_key"/>
        </constraint>
    </table>
</schema>
