<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="commercekings_app_health_run" instance="CommerceKings\AppHealth\Cron\RunChecks" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job name="commercekings_app_health_summary" instance="CommerceKings\AppHealth\Cron\QueueSummaries" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
    </group>
</config>
