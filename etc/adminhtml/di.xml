<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- the admin's system messages: App health silent on a copy of another shop; the hourly status overdue -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="commercekings_app_health_copy" xsi:type="string">CommerceKings\AppHealth\Model\System\CopyMessage</item>
                <item name="commercekings_app_health_status_overdue" xsi:type="string">CommerceKings\AppHealth\Model\System\StatusOverdueMessage</item>
            </argument>
        </arguments>
    </type>
</config>
