<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- the checks, in the order they run (argument "checks": name => CheckInterface for a shop-wide check,
         WebsiteCheckInterface for a check per website); another module adds its own -->
    <type name="CommerceKings\AppHealth\Model\CheckPool">
        <arguments>
            <argument name="checks" xsi:type="array">
                <item name="cron" xsi:type="object">CommerceKings\AppHealth\Model\Check\Cron</item>
                <item name="indexers" xsi:type="object">CommerceKings\AppHealth\Model\Check\Indexers</item>
                <item name="caches" xsi:type="object">CommerceKings\AppHealth\Model\Check\Caches</item>
                <item name="maintenance" xsi:type="object">CommerceKings\AppHealth\Model\Check\Maintenance</item>
                <item name="email_disabled" xsi:type="object">CommerceKings\AppHealth\Model\Check\EmailDisabled</item>
                <item name="exceptions" xsi:type="object">CommerceKings\AppHealth\Model\Check\Exceptions</item>
                <item name="queues" xsi:type="object">CommerceKings\AppHealth\Model\Check\Queues</item>
                <item name="email_failing" xsi:type="object">CommerceKings\AppHealth\Model\Check\EmailFailing</item>
                <item name="sales_emails" xsi:type="object">CommerceKings\AppHealth\Model\Check\SalesEmails</item>
                <item name="system_log" xsi:type="object">CommerceKings\AppHealth\Model\Check\SystemLog</item>
                <item name="sensitive_data" xsi:type="object">CommerceKings\AppHealth\Model\Check\SensitiveData</item>
            </argument>
        </arguments>
    </type>
    <!-- the log sources and their parsers, by the check that reads them (argument "sources": name =>
         [source => LogSourceInterface, parser => LogParserInterface, check => code]); another module adds its own -->
    <virtualType name="CommerceKingsAppHealthSystemLogSource" type="CommerceKings\AppHealth\Model\Log\FileLogSource">
        <arguments>
            <argument name="code" xsi:type="string">system</argument>
            <argument name="fileConfigPath" xsi:type="string">commercekings_app_health/system_log/file</argument>
        </arguments>
    </virtualType>
    <virtualType name="CommerceKingsAppHealthExceptionLogSource" type="CommerceKings\AppHealth\Model\Log\FileLogSource">
        <arguments>
            <argument name="code" xsi:type="string">exception</argument>
            <argument name="fileConfigPath" xsi:type="string">commercekings_app_health/exceptions/file</argument>
        </arguments>
    </virtualType>
    <type name="CommerceKings\AppHealth\Model\Log\LogSourcePool">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="system" xsi:type="array">
                    <item name="source" xsi:type="object">CommerceKingsAppHealthSystemLogSource</item>
                    <item name="parser" xsi:type="object">CommerceKings\AppHealth\Model\Log\MonologLineParser</item>
                    <item name="check" xsi:type="string">system_log</item>
                </item>
                <item name="exception" xsi:type="array">
                    <item name="source" xsi:type="object">CommerceKingsAppHealthExceptionLogSource</item>
                    <item name="parser" xsi:type="object">CommerceKings\AppHealth\Model\Log\MonologLineParser</item>
                    <item name="check" xsi:type="string">exceptions</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- sensitive-data rule sets: every module's etc/app_health_rules.xml, merged by ruleset and rule code -->
    <virtualType name="CommerceKingsAppHealthRulesReader" type="Magento\Framework\Config\Reader\Filesystem">
        <arguments>
            <argument name="converter" xsi:type="object">CommerceKings\AppHealth\Model\Sensitive\Config\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">CommerceKings\AppHealth\Model\Sensitive\Config\SchemaLocator</argument>
            <argument name="fileName" xsi:type="string">app_health_rules.xml</argument>
            <argument name="idAttributes" xsi:type="array">
                <item name="/config/ruleset" xsi:type="string">code</item>
                <item name="/config/ruleset/rule" xsi:type="string">code</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="CommerceKingsAppHealthRulesData" type="Magento\Framework\Config\Data">
        <arguments>
            <argument name="reader" xsi:type="object">CommerceKingsAppHealthRulesReader</argument>
            <argument name="cacheId" xsi:type="string">commercekings_app_health_rules</argument>
        </arguments>
    </virtualType>
    <type name="CommerceKings\AppHealth\Model\Sensitive\Rules">
        <arguments>
            <argument name="ruleSets" xsi:type="object">CommerceKingsAppHealthRulesData</argument>
        </arguments>
    </type>
    <!-- validators rule sets use by code (argument "validators": name => SensitiveDataValidatorInterface) -->
    <type name="CommerceKings\AppHealth\Model\Sensitive\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="luhn" xsi:type="object">CommerceKings\AppHealth\Model\Sensitive\Validator\Luhn</item>
                <item name="iban" xsi:type="object">CommerceKings\AppHealth\Model\Sensitive\Validator\Iban</item>
            </argument>
        </arguments>
    </type>
    <!-- the broker is only reached when the queue check runs -->
    <type name="CommerceKings\AppHealth\Model\Check\Queues">
        <arguments>
            <argument name="amqp" xsi:type="object">Magento\Framework\Amqp\ConfigPool\Proxy</argument>
        </arguments>
    </type>
    <!-- the alert and the daily summary go through Notification's queue and consumer -->
    <type name="CommerceKings\Notification\Model\TypePool">
        <arguments>
            <argument name="types" xsi:type="array">
                <item name="app_health_alert" xsi:type="object">CommerceKings\AppHealth\Model\Notification\Alert</item>
                <item name="app_health_summary" xsi:type="object">CommerceKings\AppHealth\Model\Notification\Summary</item>
            </argument>
        </arguments>
    </type>
</config>
